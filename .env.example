# UNSPIN environment variables. Copy what you need into .env.local (never commit secrets).
# No secret below may ever use a NEXT_PUBLIC_ prefix.

# --- Required for chart/PDF extraction ---------------------------------------
# Server-only Gemini API key.
GEMINI_API_KEY=
# Explicit model id (check availability for your key: https://ai.google.dev/gemini-api/docs/models).
# Extraction stays disabled until both GEMINI_API_KEY and GEMINI_MODEL are set.
GEMINI_MODEL=

# --- Persistence (optional; default is process memory, lost on restart) ------
# PostgreSQL connection string. When set, datasets/versions/history are durable.
# Everyday local: postgres:///unspin_dev (peer auth, no password).
# Tests: do not reuse that database; set UNSPIN_TEST_DATABASE_URL=postgres:///unspin_infra_test.
# Managed Postgres (Supabase, Tiger Data, etc.): paste the provider URI here only.
# Do not add a Supabase JS client. sslmode=require; never sslmode=no-verify.
DATABASE_URL=
# memory | filesystem | s3. Defaults to filesystem when DATABASE_URL is set, else memory.
UNSPIN_STORAGE_MODE=filesystem
# Private directory for filesystem blobs (outside public/).
UNSPIN_STORAGE_ROOT=.data/blobs

# --- Jobs ---------------------------------------------------------------------
# inline: bounded extraction runs inside the request (default).
# worker: requests enqueue jobs; run `npm run worker` in a second terminal (requires DATABASE_URL).
UNSPIN_JOBS_MODE=worker

# --- Deployment origin ----------------------------------------------------------
APP_BASE_URL=

# --- Optional S3-compatible private object storage ---------------------------------
UNSPIN_S3_ENDPOINT=
UNSPIN_S3_REGION=
UNSPIN_S3_BUCKET=
UNSPIN_S3_ACCESS_KEY_ID=
UNSPIN_S3_SECRET_ACCESS_KEY=

# --- Optional accounts (Auth0, nextjs-auth0 v4 names) -------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# --- Optional narration (ElevenLabs) -------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
