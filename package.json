{
  "name": "unspin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file-if-exists=.env.local src/server/jobs/worker.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/storage/migrate.ts"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "plotly.js-basic-dist-min": "^4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
